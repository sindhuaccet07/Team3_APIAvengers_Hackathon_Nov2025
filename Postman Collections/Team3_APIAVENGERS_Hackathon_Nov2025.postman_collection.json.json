				{
					"name": "Get skill by skill name",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "a0ef83a3-a549-4831-87a3-54b3e1a7d46b",
								"exec": [
									"\r",
									"var testData = pm.iterationData.toObject();\r",
									"\r",
									"if(testData.expectedStatusCode === 200) {\r",
									"    let jsonData = pm.response.json();\r",
									"\r",
									"    pm.test(\"skill property is present in response body\", function () {\r",
									"        try {\r",
									"            pm.expect(jsonData[0]).to.have.property(\"skillId\");\r",
									"            pm.expect(jsonData[0]).to.have.property(\"skillName\");\r",
									"            pm.expect(jsonData[0]).to.have.property(\"creationTime\");\r",
									"            pm.expect(jsonData[0]).to.have.property(\"lastModTime\");\r",
									"        } catch (e) {\r",
									"            pm.expect.fail(\"Skill property or response is not valid JSON\");\r",
									"        }\r",
									"    });\r",
									"\r",
									"    pm.test(\"Validate that skillId is not zero\", function() {\r",
									"        pm.expect(jsonData[0].skillId).to.not.eql(0);\r",
									"    });\r",
									"\r",
									"    pm.test(\"Validate skillName matchs with expected value\", function() {\r",
									"        pm.expect(jsonData[0].skillName).to.eql(pm.environment.get(\"skillMasterName\"));\r",
									"    });\r",
									"\r",
									"    pm.test(\"creationTime is valid timestamp\", function () {\r",
									"      pm.expect(Date.parse(jsonData[0].creationTime)).to.not.be.NaN;\r",
									"    });\r",
									"\r",
									"    pm.test(\"lastModTime is valid timestamp\", function () {\r",
									"        pm.expect(Date.parse(jsonData[0].lastModTime)).to.not.be.NaN;\r",
									"    });\r",
									"\r",
									"    // Validate response schema using JSON Schema validation.\r",
									"    const schema = {\r",
									"    type: \"array\",\r",
									"    items: {\r",
									"        type: \"object\",\r",
									"        required: [\r",
									"            \"skillId\", \"skillName\", \"creationTime\", \"lastModTime\" ],\r",
									"        properties: {\r",
									"            skillId: { type: \"number\" },\r",
									"            skillName: { type: \"string\" },\r",
									"            creationTime: { type: \"string\" },\r",
									"            lastModTime: { type: \"string\" }\r",
									"        }\r",
									"    }\r",
									"    };\r",
									"\r",
									"    pm.test(\"Validate array of skill schema\", function () {\r",
									"        pm.response.to.have.jsonSchema(schema);\r",
									"    });\r",
									"\r",
									"}\r",
									"\r",
									"\r",
									"\r",
