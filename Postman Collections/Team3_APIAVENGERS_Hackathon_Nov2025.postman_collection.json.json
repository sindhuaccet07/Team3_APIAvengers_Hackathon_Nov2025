					"name": "Get all skills",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "7d11636f-5c76-4650-9fc0-e2edb479bd2d",
								"exec": [
									"let testData = pm.iterationData.toObject();\r",
									"\r",
									"if (testData.expectedStatusCode === 200) {\r",
									"    let jsonData = pm.response.json();\r",
									"\r",
									"    console.log(\"skillId: \", jsonData[1].skillId);\r",
									"    pm.environment.set(\"skillId\", jsonData[1].skillId);\r",
									"\r",
									"    console.log(\"skillMasterName: \", jsonData[1].skillName);\r",
									"    pm.environment.set(\"skillMasterName\", jsonData[1].skillName);\r",
									"\r",
									"        // Validate response schema using JSON Schema validation.\r",
									"    const schema = {\r",
									"    type: \"array\",\r",
									"    items: {\r",
									"        type: \"object\",\r",
									"        required: [\r",
									"            \"skillId\", \"skillName\", \"creationTime\", \"lastModTime\" ],\r",
									"        properties: {\r",
									"            skillId: { type: \"number\" },\r",
									"            skillName: { type: \"string\" },\r",
									"            creationTime: { type: \"string\" },\r",
									"            lastModTime: { type: \"string\" }\r",
									"        }\r",
									"    }\r",
									"    };\r",
									"\r",
									"    pm.test(\"Validate array of skill schema\", function () {\r",
									"        pm.response.to.have.jsonSchema(schema);\r",
									"    });\r",
									"\r",
									"}"
								],
